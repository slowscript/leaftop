#: data/xyz.slowscript.leaftop.metainfo.xml.in:6
msgid "Graphical process manager and system monitor"
msgstr "Grafický správce procesů a systémový monitor"

#: data/xyz.slowscript.leaftop.metainfo.xml.in:10
msgid ""
"A graphical Linux system monitor program with simple process tree grouping "
"and additional system statistics. Made with plain GTK 4 (no libadwaita)."
msgstr ""
"Grafický systémový monitor pro Linux s jednoduchým seskupováním stromu "
"procesů a dalšími systémovými statistikami. Vytvořeno s čistým GTK 4 (bez "
"libadwaita)."

