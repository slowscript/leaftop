<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="leaftop">
	<schema id="xyz.slowscript.leaftop" path="/xyz/slowscript/leaftop/">
		<key name="process-grouping" type="s">
			<default>"simple"</default>
			<choices>
				<choice value="simple"/>
				<choice value="flat"/>
				<choice value="tree"/>
				<choice value="cgroup"/>
			</choices>
		</key>
		<key name="cpu-chart-split" type="b">
			<default>false</default>
		</key>
		<key name="cpu-chart-show-system" type="b">
			<default>false</default>
		</key>
		<key name="process-sort-column" type="i">
			<default>3</default>
		</key>
		<key name="process-sort-order" type="i">
			<default>1</default>
		</key>
		<key name="process-group-roots" type="as">
			<default>[]</default>
		</key>
	</schema>
</schemalist>
